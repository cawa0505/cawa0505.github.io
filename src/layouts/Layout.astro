---
const {
  title = 'Jimmy Yen',
  description = 'Building sicker tools than yesterday. Technical articles, open-source high-performance tools.',
  active = '',
  extraStyles = [],
} = Astro.props;
const pageTitle = title === 'Jimmy Yen' ? title : `${title} :: Jimmy Yen`;
---
<!doctype html>
<html lang="en">
  <head>
    <title>{pageTitle}</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1.0,maximum-scale=1" />
    <meta name="robots" content="noodp" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="stylesheet" href="/style.css" />
    <link rel="stylesheet" href="/color/purple.css" />
    <link rel="stylesheet" href="/color/background_dark.css" />
    <link rel="stylesheet" href="/font-hack.css" />
    {extraStyles.map((href) => <link rel="stylesheet" href={href} />)}
  </head>
  <body>
    <div class="container">
      <header class="header">
        <div class="header__inner">
          <div class="header__logo">
            <a href="/" style="text-decoration:none"><div class="logo">Jimmy Yen</div></a>
          </div>
        </div>
        <nav class="menu">
          <ul class="menu__inner">
            <li class={active === 'blog' ? 'active' : ''}><a href="/">blog</a></li>
            <li class={active === 'tags' ? 'active' : ''}><a href="/tags/">tags</a></li>
            <li class={active === 'archive' ? 'active' : ''}><a href="/archive/">archive</a></li>
            <li class={active === 'donate' ? 'active' : ''}><a href="/donate/">donate</a></li>
            <li><a href="https://github.com/cawa0505" target="_blank" rel="noopener noreferrer">github</a></li>
          </ul>
        </nav>
      </header>
      <main class="content">
        <slot />
      </main>
      <footer class="footer">
        <div class="footer__inner">
          <div class="copyright copyright--user">© Jimmy Yen</div>
        </div>
      </footer>
    </div>
  </body>
</html>
