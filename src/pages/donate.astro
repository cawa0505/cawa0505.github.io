---
import Layout from '../layouts/Layout.astro';

const wallet = '4pb8p2cTHdQb9WmU68n6AtQ3rrEHEzkQoESAXADzwKSF';
const donateUrl = `solana:${wallet}?label=JimmyStudio&message=donation`;
---
<Layout
  title="Jimmy Yen"
  description="Support open-source tools for the AI agent era."
  active="donate"
  extraStyles={["/donate.css"]}
>
  <div class="donate">
    <div class="term">
      <div class="term-bar">
        <span class="dot dot-r"></span><span class="dot dot-y"></span><span class="dot dot-g"></span>
        <span class="term-title">support.sh — zsh</span>
      </div>
      <div class="term-body">
        <p class="cmd"><span class="prompt">$</span> ./support.sh<span aria-hidden="true" class="cur"></span></p>
        <p class="term-out">open-source tools for the AI agent era.<br />support keeps them running.</p>
        <a href={donateUrl} title="opens your wallet app" class="btn-sponsor">
          <span class="btn-caret">$</span> donate in wallet
        </a>
      </div>
    </div>

    <section class="funds">
      <h2 class="sec"><span class="prompt">$</span> where --funds</h2>
      <ul class="funds-list">
        <li><span class="plus">+</span> <strong>cross-platform builds</strong> — single-binary releases across Linux, macOS and Windows</li>
        <li><span class="plus">+</span> <strong>local, offline-first AI</strong> — ONNX/WASM local reranking and Qdrant-backed retrieval, no cloud dependency</li>
        <li><span class="plus">+</span> <strong>free & open-source, forever</strong> — core features stay free and open-source regardless of funding</li>
        <li><span class="plus">+</span> <strong>hub site & dev time</strong> — hosting, CI, and the hours that keep these tools maintained</li>
      </ul>
    </section>

    <section class="crypto">
      <h2 class="sec"><span class="prompt">$</span> donate --sol</h2>
      <p class="term-out">send SOL to:</p>
      <pre class="wallet"><code>{wallet}</code></pre>
    </section>

    <p class="closing"><span class="prompt">$</span> exit 0</p>
    <p class="term-out term-out-small">no matter what — core features stay free & open-source, sponsored or not.</p>
  </div>
</Layout>
