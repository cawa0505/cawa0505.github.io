---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const fmt = new Intl.DateTimeFormat('en', { year: 'numeric', month: 'long', day: 'numeric' });
const excerpt = (body) => body.split(/\n\s*\n/).find((p) => p.trim() && !p.trim().startsWith('#'))?.replace(/\[([^\]]+)\]\([^\)]+\)/g, '$1').slice(0, 260) ?? '';
---
<Layout active="blog">
  <div class="posts">
    {posts.map((post) => (
      <div class="post on-list">
        <h1 class="post-title"><a href={`/${post.id}/`}>{post.data.title}</a></h1>
        <div class="post-meta"><span class="post-date">{fmt.format(post.data.date)}</span></div>
        {post.data.tags.length > 0 && <span class="post-tags">{post.data.tags.map((tag) => <a href={`/tags/${tag}/`}>#{tag}</a>)}</span>}
        {excerpt(post.body) && <div class="post-content"><p>{excerpt(post.body)}…</p></div>}
        <a class="read-more button" href={`/${post.id}/`}>Read more →</a>
      </div>
    ))}
  </div>
</Layout>
