---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
const posts = await getCollection('blog', ({ data }) => !data.draft);
const counts = new Map();
for (const post of posts) for (const tag of post.data.tags) counts.set(tag, (counts.get(tag) ?? 0) + 1);
const tags = [...counts.entries()].sort(([a], [b]) => a.localeCompare(b));
---
<Layout title="Tags" active="tags">
  <div class="post">
    <h1 class="post-title">Tags</h1>
    <ul>
      {tags.map(([tag, count]) => <li><a href={`/tags/${tag}/`}>#{tag}</a> ({count})</li>)}
    </ul>
  </div>
</Layout>
